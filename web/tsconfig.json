{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true, 
    "noEmit": false,  // Set to false to allow TypeScript to emit compiled files
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node", "express"],
    "outDir": "./dist",  // Ensure compiled files go into 'dist'
    "baseUrl": ".",  // Make sure baseUrl is set correctly
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts", 
    "**/*.ts", 
    "**/*.tsx", 
    ".next/types/**/*.ts", 
    "server.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
